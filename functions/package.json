{
  "name": "ghost-resource-buster-functions",
  "version": "0.2.0",
  "description": "Cloud Functions for Ghost Resource Buster",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "firebase emulators:exec --only firestore,auth --project demo-ghost-buster \"node --test --test-concurrency=1 test/*.test.js\"",
    "test:unit": "node --test test/unit.test.js",
    "predemo": "node scripts/ensure-local-secret.js",
    "demo": "firebase emulators:exec --project demo-ghost-buster --ui \"node scripts/demo.js\"",
    "seed": "node scripts/seed.js",
    "simulate": "node scripts/simulate.js",
    "set-role": "node scripts/set-role.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "private": true
}
