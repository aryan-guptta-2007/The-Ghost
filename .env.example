# ---- Edge device (edge_ai/) --------------------------------------------
# This room's own key: `GHOST_HMAC_SECRET=<master> npm run device-key -- room_101`
# in backend/, where <master> is GHOST_HMAC_SECRET from Vercel. A stolen device
# can then only sign for its own room. (The master secret itself also works,
# unless GHOST_REQUIRE_DEVICE_KEYS=true is set in Vercel.)
GHOST_HMAC_SECRET=change-me-use-the-device-key-for-this-room
GHOST_BACKEND_URL=https://<your-app>.vercel.app/api/occupancy
DEVICE_ID=edge_cam_01
ROOM_ID=room_101
DEVICE_INDEX_NUM=0
GHOST_CAPTURE_INTERVAL=2.0
GHOST_HEARTBEAT_SECONDS=300

# Detection tuning
GHOST_MIN_CONFIDENCE=0.3
GHOST_WINDOW_SIZE=10
GHOST_FLIP_THRESHOLD=7
