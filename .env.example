# ---- Edge device (edge_ai/) --------------------------------------------
# Must match GHOST_HMAC_SECRET in the Vercel project's environment variables
GHOST_HMAC_SECRET=change-me-generate-with-openssl-rand-hex-32
GHOST_BACKEND_URL=https://<your-app>.vercel.app/api/occupancy
DEVICE_ID=edge_cam_01
ROOM_ID=room_101
GHOST_CAPTURE_INTERVAL=2.0
GHOST_HEARTBEAT_SECONDS=300

# Detection tuning
GHOST_MIN_CONFIDENCE=0.5
GHOST_WINDOW_SIZE=10
GHOST_FLIP_THRESHOLD=7
