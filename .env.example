# ---- Edge device (edge_ai/) --------------------------------------------
# Must match the value set in Firebase: functions:config:set ghost.hmac_secret=...
GHOST_HMAC_SECRET=change-me-generate-with-openssl-rand-hex-32
GHOST_BACKEND_URL=https://<region>-<project-id>.cloudfunctions.net/receiveOccupancy
DEVICE_ID=edge_cam_01
ROOM_ID=room_101
GHOST_CAPTURE_INTERVAL=2.0
GHOST_HEARTBEAT_SECONDS=60

# Detection tuning
GHOST_MIN_CONFIDENCE=0.5
GHOST_WINDOW_SIZE=10
GHOST_FLIP_THRESHOLD=7

# ---- Energy controller (energy/) ---------------------------------------
MOCK_AC_POWER_W=3500
MOCK_LIGHTS_POWER_W=800
MOCK_ENERGY_LOGS_FIRESTORE=audit_logs
