rules_version = '2';

// Ghost Resource Buster — Firestore security rules
//
// Clients read. Apart from two narrow self-service writes (cancelling your
// own booking, registering your own FCM token), every write goes through a
// Cloud Function using the Admin SDK, which bypasses these rules: readings
// are HMAC-verified, bookings are overlap-checked, confirmations are tied
// to an ID token.
//
// Roles are custom claims, set with functions/scripts/set-role.js:
//   admin  full read access
//   demo   same read access, for the public demo login. It has no extra
//          write power; the demo panel calls demoAction, which only touches
//          rooms flagged demo: true.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn()
        && (request.auth.token.admin == true || request.auth.token.demo == true);
    }

    function isOwner(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    // ---- Rooms -------------------------------------------------------
    // Anyone signed in can see rooms and their live reading.
    match /rooms/{roomId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ---- Bookings ----------------------------------------------------
    // Created only through the createBooking function (overlap check).
    // An owner may cancel their own booking and change nothing else.
    match /bookings/{bookingId} {
      allow read:   if isStaff() || isOwner(resource.data);
      allow create: if false;
      allow update: if isOwner(resource.data)
                    && request.resource.data.status == 'canceled'
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // ---- Occupancy ---------------------------------------------------
    // Written only by receiveOccupancy after HMAC verification. A client
    // write here could forge "room is empty" and cancel someone's booking.
    match /occupancy/{occId} {
      allow read:  if isStaff();
      allow write: if false;
    }

    // ---- Enforcement and confirmations -------------------------------
    match /enforcement/{bookingId} {
      allow read:  if isStaff();
      allow write: if false;
    }

    // The owner reads their own warning; answering it goes through
    // confirmAttendance, which checks their ID token.
    match /confirmations/{bookingId} {
      allow read:  if isStaff() || isOwner(resource.data);
      allow write: if false;
    }

    // ---- Dashboard counters ------------------------------------------
    match /stats/{statId} {
      allow read:  if isStaff();
      allow write: if false;
    }

    // ---- Append-only audit trail ------------------------------------
    // No updates, no deletes, for anyone. Only the Admin SDK writes.
    match /audit_logs/{logId} {
      allow read:  if isStaff();
      allow write: if false;
    }

    match /decision_logs/{logId} {
      allow read:  if isStaff();
      allow write: if false;
    }

    // ---- Users -------------------------------------------------------
    match /users/{userId} {
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == userId);
      // A user may register their own FCM token but nothing else.
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['fcmToken']);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
